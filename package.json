{
  "name": "collab-canvas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -k -n web,worker \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "npm run dev --workspace=@collab-canvas/web",
    "dev:worker": "npm run dev --workspace=@collab-canvas/sync-worker",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@collab-canvas/web --if-present",
    "test:watch": "npm run test:watch --workspace=@collab-canvas/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "9.2.0",
    "eslint": "10.8.0",
    "prettier": "3.6.2",
    "supabase": "2.110.0"
  }
}
