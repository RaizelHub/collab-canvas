{
  "name": "@collab-canvas/sync-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "cross-env XDG_CONFIG_HOME=.wrangler/config WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir dist",
    "dev": "cross-env XDG_CONFIG_HOME=.wrangler/config WRANGLER_WRITE_LOGS=false wrangler dev",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@collab-canvas/shared": "0.0.0",
    "@tldraw/sync-core": "5.2.5",
    "@tldraw/tlschema": "5.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@eslint/js": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7",
    "wrangler": "4.116.0"
  }
}
